{
  "metadata": {
    "version": "1.0",
    "last_updated": "2023-05-02"
  },
  "icons": [
    {"icon": "🛑", "meaning": "Unknown. No obvious docs, research in progress"},
    {"icon": "😵", "meaning": "Discontinued and/or no longer maintained"},
    {"icon": "🚸", "meaning": "HW Physically unsafe with \"full secret\" (ie without BIP39 passphrase or multisig) against a automated attack and/or unsophisticated attacker (ie chipshouter blackbox)"},
    {"icon": "👁", "meaning": "Privacy concerns (default is third party node)"},
    {"icon": "⑂", "meaning": "Validation concerns (default is third party node)"},
    {"icon": "☠️", "meaning": "Not publicly available, or complex without a external tool available for the average user"},
    {"icon": "⚠️", "meaning": "Known, but unofficially documented"},
    {"icon": "✅", "meaning": "Documented + Link to doc"},
    {"icon": "🧐", "meaning": "New project and/or team"}
  ],
  "schema": {
    "wallet": {
      "properties": {
        "status": "String of status icons",
        "name": "Wallet name",
        "url": "Website URL",
        "paths": {
          "bip44": "Boolean - supports m/44'/0'/0' (Legacy P2PKH)",
          "bip49": "Boolean - supports m/49'/0'/0' (SegWit P2SH-P2WPKH)",
          "bip84": "Boolean - supports m/84'/0'/0' (Native SegWit P2WPKH)",
          "bip48": "Boolean - supports m/48'/0'/0'/2' (Multisig)",
          "bip86": "Boolean - supports m/86'/0'/0' (Taproot P2TR)",
          "brd": "Boolean - supports m/0' (BRD style)",
          "custom": "String with any custom paths description"
        },
        "bip39_pass": "Yes|No|Optional|N/A|Required",
        "bip174_psbt": "Yes|No|N/A|WIP",
        "wif_support": "Yes|No|N/A",
        "notes": "Documentation and additional information"
      }
    },
    "lightning_wallet": {
      "properties": {
        "status": "String of status icons",
        "name": "Wallet name",
        "url": "Website URL",
        "paths": {
          "bip44": "Boolean - supports m/44'/0'/0' (Legacy P2PKH)",
          "bip49": "Boolean - supports m/49'/0'/0' (SegWit P2SH-P2WPKH)",
          "bip84": "Boolean - supports m/84'/0'/0' (Native SegWit P2WPKH)",
          "bip48": "Boolean - supports m/48'/0'/0'/2' (Multisig)",
          "bip86": "Boolean - supports m/86'/0'/0' (Taproot P2TR)",
          "brd": "Boolean - supports m/0' (BRD style)",
          "custom": "String with any custom paths description"
        },
        "passphrase": "Yes|No|Optional|N/A",
        "notes": "Documentation and additional information"
      }
    }
  },
